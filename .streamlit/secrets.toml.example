# Copy these into the app's "Secrets" box on Streamlit Community Cloud
# (or into .streamlit/secrets.toml locally - that file is never committed).

# Identifies the app to Wikipedia/Wikidata so it isn't rate-limited. Use the app's public URL.
WIKIMEDIA_CONTACT = "https://github.com/ZCusumano81/trial-modality-finder"

# Optional: where "Suggest a correction" emails go. Leave out to hide the link.
# CORRECTIONS_EMAIL = "corrections@example.org"
